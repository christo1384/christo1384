# Home box service unit, Tailscale Serve variant (recommended).
# The app listens only on the loopback address; Tailscale terminates TLS with a
# real certificate and proxies to it, so nothing is exposed on the LAN.
#
#   sudo cp deploy/contracting-ops-tailscale.service /etc/systemd/system/contracting-ops.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now contracting-ops
#   sudo tailscale serve --bg 4000
#
# Adjust User and WorkingDirectory to match where you cloned this.
[Unit]
Description=Contracting Ops
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/contracting-ops
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Environment=NODE_ENV=production
Environment=PORT=4000
# Loopback only: Tailscale Serve is the sole way in.
Environment=HOST=127.0.0.1
# Serve terminates TLS and forwards plain HTTP, so the app cannot tell the
# connection was encrypted. This tells it, so session cookies get Secure.
Environment=COOKIE_SECURE=1
Restart=always
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/contracting-ops/data /opt/contracting-ops/backups
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target

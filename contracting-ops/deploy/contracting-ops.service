# Home box service unit.
#   sudo cp deploy/contracting-ops.service /etc/systemd/system/
#   sudo systemctl enable --now contracting-ops
# Adjust User and WorkingDirectory to match where you cloned this.
[Unit]
Description=Contracting Ops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A dedicated account, NOT a shared 'ops' user. Anything else running on
# this box under the same account could read the books.
User=contracting-ops
Group=contracting-ops
WorkingDirectory=/opt/contracting-ops
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=0.0.0.0
Restart=always
RestartSec=5

# The app only ever needs to read its own directory and write data/.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/contracting-ops/data /opt/contracting-ops/backups
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
